FROM golang:1.26.5-alpine AS build
WORKDIR /app
COPY go.mod ./
COPY . .
RUN go test ./... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /hacktheplanet .

FROM alpine:3.23 AS runtime
RUN apk add --no-cache ca-certificates && adduser -D -u 1000 app
COPY --from=build /hacktheplanet /usr/local/bin/hacktheplanet
USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["hacktheplanet"]
